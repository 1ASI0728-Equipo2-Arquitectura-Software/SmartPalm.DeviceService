{
  "ConnectionStrings": {
    "DeviceDatabase": "Host=localhost;Port=5435;Database=smartpalm_device;Username=CHANGE_ME;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "smartpalm.identity",
    "Audience": "smartpalm.clients",
    "Key": "replace-with-a-secure-key-of-at-least-32-bytes"
  },
  "RabbitMq": {
    "Enabled": true,
    "Uri": "amqp://guest:guest@localhost:5672/",
    "Exchange": "smartpalm.events"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
